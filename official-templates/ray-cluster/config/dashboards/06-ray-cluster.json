    {
      "type": "timeseries",
      "id": 17,
      "title": "Active Tasks by State",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(sum by (State) (ray_tasks{State!~\"FINISHED|FAILED\"}), 0)",
          "refId": "A",
          "legendFormat": "{{State}}"
        }
      ],
      "description": "Tasks not yet finished, by state. PENDING_NODE_ASSIGNMENT is waiting for resources; PENDING_ARGS_* for upstream results; PENDING_OBJ_STORE_MEM_AVAIL for object store space; RUNNING_IN_RAY_GET / RUNNING_IN_RAY_WAIT are blocked on other tasks."
