    {
      "type": "state-timeline",
      "title": "Time Sync Status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
