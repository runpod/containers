          },
          "expr": "DCGM_FI_DEV_FAN_SPEED{Hostname=~\"$Hostname\", gpu=~\"$gpu\"}",
          "legendFormat": "{{Hostname}}/gpu{{gpu}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      }
    },
    {
      "type": "state-timeline",
      "title": "Performance State (P-state)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "DCGM_FI_DEV_PSTATE{Hostname=~\"$Hostname\", gpu=~\"$gpu\"}",
          "legendFormat": "{{Hostname}}/gpu{{gpu}}"
        }
      ],
      "description": "NVIDIA performance state (P0 = max performance, higher = more idle).",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 30
      }
    },
    {
      "type": "timeseries",
      "title": "Throttle Time (power / thermal)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "\u00b5s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(DCGM_FI_DEV_POWER_VIOLATION{Hostname=~\"$Hostname\", gpu=~\"$gpu\"}[5m])",
          "legendFormat": "{{Hostname}}/gpu{{gpu}} power"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(DCGM_FI_DEV_THERMAL_VIOLATION{Hostname=~\"$Hostname\", gpu=~\"$gpu\"}[5m])",
          "legendFormat": "{{Hostname}}/gpu{{gpu}} thermal"
        }
      ],
      "description": "Microseconds/sec the GPU was throttled. Sustained >0 means it can't run at full clocks.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      }
    },
    {
      "type": "timeseries",
      "title": "PCIe Replay Rate",
      "datasource": {
        "type": "prometheus",
