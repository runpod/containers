    "nvidia",
    "gpu",
    "utilization",
    "dcgm"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "auto",
  "time": {
    "from": "now-30m",
    "to": "now"
