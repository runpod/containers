        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_Buffers_bytes{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} buffers"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_MemFree_bytes{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} free"
