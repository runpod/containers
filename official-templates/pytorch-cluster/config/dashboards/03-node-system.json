      "description": "Fraction of time tasks stalled waiting for CPU.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "gauge",
      "title": "I/O Pressure (PSI)",
      "datasource": {
